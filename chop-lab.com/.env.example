# The Chop Lab — local server configuration
#
# Copy this file to `.env` in the same directory and fill it in. `.env` is
# git-ignored and is read by `npm run dev`, `npm run build` and `npm run
# preview` through scripts/with-app-env.mjs.
#
# Non-empty values here win over the process environment, so this file is the
# place to set them for the dev server you start yourself. Empty keys are
# ignored. On deploy there is no .env, so the platform's injected secrets are
# used.

# Order email. SMTP is the working transport; the Apps Script fallback's
# doPost currently fails, and it cannot carry the customer's uploaded files.
# For Gmail, SMTP_PASSWORD must be an App Password (Google Account → Security
# → 2-Step Verification → App passwords), not the account password.
SMTP_USER=
SMTP_PASSWORD=

# Optional. Defaults: smtp.gmail.com, port 587 (STARTTLS). Port 465 is SMTPS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
