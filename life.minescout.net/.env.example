# Minescout Life — server configuration
#
# Copy to .env and fill in. Never commit the real .env.

# Signs admin/user session cookies. Any long random string.
SESSION_SECRET=

# Password for the /admin editor.
ADMIN_PASSWORD=

# Token for the MCP server at /api/mcp, which lets an AI agent write posts.
# Leave blank to disable the MCP endpoint entirely.
MCP_TOKEN=

# Optional: the chromium binary used to render MCP title images. When unset the
# server tries /usr/bin/chromium and then Playwright's bundled build.
# CHROMIUM_PATH=

# Optional: bind the dev server somewhere other than 127.0.0.1.
# DEV_HOST=
